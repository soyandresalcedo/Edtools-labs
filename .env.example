# Copia a .env.local y rellena.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Obligatorio para lecciones reales (Claude API)
ANTHROPIC_API_KEY=

# Opcional: modelo (por defecto en código: claude-opus-4-7 o el que definas en src/lib/anthropic.ts)
# ANTHROPIC_MODEL=

# UI de prueba sin API: reglas en README (chips / preguntas enrutan a escenas demo)
DEMO_MODE=
